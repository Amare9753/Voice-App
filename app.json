{
  "expo": {
    "name": "Core Capture",
    "slug": "core-capture",
    "scheme": "corecapture",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.corecapture.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Core Capture records experiment notes on this device. Audio is transcribed on device and is not uploaded.",
        "NSCameraUsageDescription": "Core Capture photographs gels, plates, instrument screens, and reagent labels. Photos stay on this device.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.corecapture.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F6E56",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Core Capture photographs gels, plates, instrument screens, and reagent labels. Photos stay on this device.",
          "microphonePermission": "Core Capture records experiment notes on this device. Audio is transcribed on device and is not uploaded.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F6E56"
        }
      ],
      "expo-sharing",
      "./plugins/withWhisper.js",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "x86_64"]
          }
        }
      ]
    ]
  }
}
